# 统一换行符策略：默认自动处理，源码统一用 LF
* text=auto

# Python
*.py text eol=lf

# C/C++
*.c text eol=lf
*.cpp text eol=lf
*.cc text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.hh text eol=lf

# ROS
*.launch text eol=lf
*.msg text eol=lf
*.srv text eol=lf
*.action text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.xml text eol=lf
*.bash text eol=lf
*.sh text eol=lf

# 文档
*.md text eol=lf
*.rst text eol=lf
*.txt text eol=lf

# 标记为二进制（不做换行转换）
*.bag binary
*.mp4 binary
*.png binary
*.jpg binary
*.jpeg binary
*.tar binary

# 模型权重走 Git LFS（大文件管理）
*.pt filter=lfs diff=lfs merge=lfs -text
