<?xml version="1.0"?>
<!--
perception.launch — FSAC 感知全链路启动文件
============================================
启动顺序：
  1. cone_detector    : 订阅图像 → YOLOv8 检测 → 发布 /test/camera_cones
  2. demo01_sub       : 订阅 /test/camera_cones → 坐标转换 → 发布 /car/cones
  3. visualization_rviz: 订阅 /car/cones → MarkerArray → 发布 /visual/cones
  4. rviz             : 可视化显示

用法：
  # 使用 pylon 相机实时检测
  roslaunch plumbing_pub_sub perception.launch

  # 从 bag 文件回放检测（需要包含图像数据的 bag）
  roslaunch plumbing_pub_sub perception.launch bag_path:=/path/to/images.bag

  # 使用自定义模型
  roslaunch plumbing_pub_sub perception.launch model_path:=/home/xiaoyang/桌面/August_task/results/best.pt
-->
<launch>

    <!-- ============ 参数 ============ -->
    <arg name="image_topic"     default="/pylon_camera_node/image_raw" />
    <arg name="model_path"      default="yolov8n.pt" />
    <arg name="conf_threshold"  default="0.5" />
    <arg name="iou_threshold"   default="0.45" />
    <arg name="imgsz"           default="1280" />   <!-- 640均衡 / 960高精 / 1280极致 -->
    <arg name="show_gui"        default="false" />  <!-- GUI 吃内存，默认关闭 -->
    <arg name="publish_2d"      default="false" />
    <arg name="bag_path"        default="" />
    <arg name="bag_topic"       default="/pylon_camera_node/image_raw" />
    <arg name="bag_rate"        default="0.5" />  <!-- 播放倍速，<1 给 CPU 推理留时间 -->

    <!-- ============ 相机参数（对齐学长标定值） ============ -->
    <arg name="fx"             default="1379" />
    <arg name="fy"             default="1378" />
    <arg name="cx"             default="984" />
    <arg name="cy"             default="611" />
    <arg name="camera_x"       default="0.3" />     <!-- 相机在前0.3m -->
    <arg name="camera_y"       default="0.0" />
    <arg name="camera_z"       default="0.5" />     <!-- 相机在上0.5m -->

    <!-- ============ 1. YOLO 锥桶检测节点（感知链路"头"） ============ -->
    <node pkg="plumbing_pub_sub" type="cone_detector.py" name="cone_detector" output="screen">
        <param name="image_topic"    value="$(arg image_topic)" />
        <param name="model_path"     value="$(arg model_path)" />
        <param name="conf_threshold" value="$(arg conf_threshold)" />
        <param name="iou_threshold"  value="$(arg iou_threshold)" />
        <param name="imgsz"          value="$(arg imgsz)" />
        <param name="show_gui"       value="$(arg show_gui)" />
        <param name="publish_2d"     value="$(arg publish_2d)" />
    </node>

    <!-- ============ 2. 坐标转换节点（pixel_to_cam_3d → sensor_to_vehicle） ============ -->
    <node pkg="plumbing_pub_sub" type="demo01_sub" name="demo01_sub" output="screen">
        <param name="fx"              value="$(arg fx)" />
        <param name="fy"              value="$(arg fy)" />
        <param name="cx"              value="$(arg cx)" />
        <param name="cy"              value="$(arg cy)" />
        <param name="camera_x"        value="$(arg camera_x)" />
        <param name="camera_y"        value="$(arg camera_y)" />
        <param name="camera_z"        value="$(arg camera_z)" />
    </node>

    <!-- ============ 3. 可视化节点（ConeInfo → MarkerArray） ============ -->
    <node pkg="plumbing_pub_sub" type="visualization_rviz" name="visualization_rviz" output="screen" />

    <!-- ============ 4. RViz 显示 ============ -->
    <node pkg="rviz" type="rviz" name="rviz" output="screen"
          args="-d $(find plumbing_pub_sub)/rviz/config.rviz" />

    <!-- ============ 5. [可选] Bag 回放 ============ -->
    <node pkg="rosbag" type="play" name="rosbag_play" output="screen"
          args="$(arg bag_path) --topic $(arg bag_topic) -r $(arg bag_rate) -q"
          if="$(eval bag_path != '')" />

</launch>
